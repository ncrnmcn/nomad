views:
  - type: table
    name: Table
    filters:
      or:
        - file.folder == "01 Orte"
        - file.folder == "02 Personen"
        - file.folder == "04 Reports"
        - file.folder == "03 Gruppen"
        - file.folder == "/"
    order:
      - file.name
      - dg-publish
      - draft
      - enableToc
      - mocs
      - tags
      - file.mtime
    sort:
      - property: file.mtime
        direction: DESC
      - property: tags
        direction: ASC
      - property: date modified
        direction: ASC
    columnSize:
      note.dg-publish: 113
      note.mocs: 247
      note.tags: 131
