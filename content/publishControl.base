views:
  - type: table
    name: Table
    filters:
      or:
        - file.folder == "Orte"
        - file.folder == "Personen"
    order:
      - file.name
      - dg-publish
      - draft
      - enableToc
      - mocs
      - tags
      - file.mtime
    sort:
      - property: date modified
        direction: ASC
    columnSize:
      note.dg-publish: 113
      note.mocs: 247
      note.tags: 131
